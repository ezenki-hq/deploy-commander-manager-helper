{
  "name": "deploy-commander-manager-sdk",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "compile": "npm run compile --workspace=@ezenki/deploy-commander-manager-sdk-core && npm run compile --workspaces --if-present && npm run build:styles",
    "typecheck": "npm run compile --workspace=@ezenki/deploy-commander-manager-sdk-core && npm run compile --workspaces --if-present && npm run typecheck --workspace=@ezenki/deploy-commander-manager-sdk-core && npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run compile && npm run check:react-types && node --test test/*.test.mjs && npm run test:runtime --workspaces --if-present",
    "build:styles": "node scripts/build-configuration-styles.mjs",
    "check:react-types": "node scripts/check-react-types.mjs",
    "build": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "@eslint/js": "^9.39.4",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tailwindcss/cli": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^9.39.4",
    "eslint-plugin-svelte": "^3.24.1",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^26.1.0",
    "ng-packagr": "^21.2.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.4.6",
    "vitest": "^5.1.2",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14",
    "zone.js": "^0.16.3"
  },
  "dependencies": {
    "svelte": "^5.59.1"
  }
}
