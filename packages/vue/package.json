{
  "name": "@ezenki/deploy-commander-manager-sdk-vue",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "compile": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && node ../../scripts/check-vue-types.mjs"
  },
  "dependencies": {
    "@ezenki/deploy-commander-manager-sdk-core": "*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.0",
    "vite": "^6.4.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.14"
  }
}
