{
  "name": "@ezenki/deploy-commander-manager-sdk-svelte",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "compile": "svelte-package -i src -o dist --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --workspace . --tsconfig ./tsconfig.json --config ./svelte.config.js --fail-on-warnings && node ../../scripts/check-svelte-types.mjs",
    "test:runtime": "vitest run --config vite.config.ts"
  },
  "dependencies": {
    "@ezenki/deploy-commander-manager-sdk-core": "*"
  },
  "peerDependencies": {
    "svelte": ">=5.20.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@testing-library/svelte": "^5.2.0",
    "svelte": "^5.20.0",
    "svelte-check": "^4.0.0",
    "vitest": "^5.1.2"
  }
}
